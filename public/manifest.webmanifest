{
  "id": "/",
  "name": "Stanz Calc — Scientific Calculator & Currency Converter",
  "short_name": "Stanz Calc",
  "description": "Retro tactile scientific calculator and live currency converter. Works fully offline.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#CFCBC0",
