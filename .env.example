# Copy to .env.local for local dev, or set these in your host's build-time
# environment variables. Every VITE_* var here is baked into the client bundle
# at build time — never put a real secret in one (see README "Analytics &
# admin dashboard" section for the security tradeoffs this implies).

# --- Admin dashboard (src/admin/AdminDashboard.tsx), served at /admin ---
# Required to enable the dashboard at all; it stays disabled without it.
VITE_ADMIN_PASSCODE=

# --- Optional: PostHog product analytics ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Optional: Umami analytics (cloud or self-hosted) ---
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=https://cloud.umami.is/script.js

# --- Optional: Supabase table for cross-device aggregate stats ---
# Without these, the admin dashboard only shows this device's own local event log.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_EVENTS_TABLE=app_events
