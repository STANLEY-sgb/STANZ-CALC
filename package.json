{
  "name": "stanz-calc",
  "private": true,
  "version": "1.0.0",
  "description": "Stanz Calc — retro scientific calculator and live currency converter for stanz-apps.online",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons:gen": "node scripts/gen-icons.cjs",
    "cap:sync": "npm run build && npx cap sync",
